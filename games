========================= -->

<script>

document.addEventListener("DOMContentLoaded", function(){

  const container =
    document.getElementById("moreGames");

  if(!container) return;

  fetch("../games.json")
    .then(response => {

      if(!response.ok){
        throw new Error("games.json could not be loaded");
      }

      return response.json();

    })
    .then(games => {

      const currentPage =
        window.location.pathname
          .split("/")
          .pop();

      const otherGames =
        games
          .filter(game => {

            if(!game.link) return false;

            return game.link
              .split("/")
              .pop()
              !== currentPage;

          })
          .slice(0, 8);

      if(otherGames.length === 0){

        container.innerHTML =
          '<div class="loading-games">More games will be available soon.</div>';

        return;
      }

      container.innerHTML =
        otherGames.map(game => `

          <div class="more-game-card">

            <img
              src="../images/${game.image}"
              alt="${game.name}"
              loading="lazy">

            <h3>${game.name}</h3>

            <div class="more-game-rating">
              ⭐ ${game.rating || "—"}
            </div>

            <a
              href="../${game.link}"
              class="more-game-btn">

              View Game

            </a>

          </div>

        `).join("");

    })
    .catch(error => {

      console.error(error);

      container.innerHTML = `
        <div class="loading-games">
          More games could not be loaded right now.
        </div>
      `;

    });

});

</script>
